#!/bin/bash
#      +--------------------------------------------------------+
#      | WAVEWATCH IV, open source, code management by NOAA/NWS |
#      +--------------------------------------------------------+
#
# @file ww4_clean
# @brief A tool to remove intermediate files created by compilation.
# @details This script cleans the 'build' directory in the repository root
#          and removes the log file.
#
# Usage
# -----
# Run the clean tool from any directory within the clone:
#    ww4_clean
#
# @copyright © 2026 National Weather Service, National Oceanic and Atmospheric
#               Administration. WAVEWATCH IV (TM) and WW4 (TM) are trademarks
#               of the National Weather Service.
# @author Main Author(s): Aldgisl (AI Persona), Hendrik L. Tolman
# @author Contributors: Jules (Agentic AI)
# @date Initial, 2026-03-30
# @date Last Update, 2026-04-07

# Identify the repository root (parent of the directory containing this script)
TOOLS_DIR=$(cd "$(dirname "$0")" && pwd)
ACTIVE_CLONE=$(cd "$TOOLS_DIR/.." && pwd)

BUILD_DIR="$ACTIVE_CLONE/build"

if [ -d "$BUILD_DIR" ]; then
    echo "Cleaning build directory: $BUILD_DIR"
    cmake --build "$BUILD_DIR" --target clean
    if [ $? -eq 0 ]; then
        echo "Build directory cleaned."
    else
        echo "Error cleaning build directory."
        exit 1
    fi
else
    echo "No build directory found. Nothing to clean in build."
fi

# Remove log file from the root directory
if [ -f "$ACTIVE_CLONE/log.ww4" ]; then
    echo "Removing log file: $ACTIVE_CLONE/log.ww4"
    rm -f "$ACTIVE_CLONE/log.ww4"
    if [ $? -eq 0 ]; then
        echo "Log file removed."
    else
        echo "Error removing log file."
    fi
else
    echo "No log file found. Nothing to clean in root."
fi

echo -e "\nClean complete."

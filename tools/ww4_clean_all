#!/bin/bash
#      +--------------------------------------------------------+
#      | WAVEWATCH IV, open source, code management by NOAA/NWS |
#      +--------------------------------------------------------+
#
# @file ww4_clean_all
# @brief A tool to remove all compilation output, including executables and libraries.
# @details This script removes the 'build' and 'exe' directories and the log file.
#
# Usage
# -----
# Run the clean_all tool from any directory within the clone:
#    ww4_clean_all
#
# @copyright © 2026 National Weather Service, National Oceanic and Atmospheric
#               Administration. WAVEWATCH IV (TM) and WW4 (TM) are trademarks
#               of the National Weather Service.
# @author Main Author(s): Aldgisl (AI Persona), Hendrik L. Tolman
# @author Contributors: Jules (Agentic AI)
# @date Initial, 2026-03-30
# @date Last Update, 2026-04-07

# Identify the repository root (parent of the directory containing this script)
TOOLS_DIR=$(cd "$(dirname "$0")" && pwd)
ACTIVE_CLONE=$(cd "$TOOLS_DIR/.." && pwd)

BUILD_DIR="$ACTIVE_CLONE/build"
EXE_DIR="$ACTIVE_CLONE/exe"

# Remove build directory
if [ -d "$BUILD_DIR" ]; then
    echo "Removing build directory: $BUILD_DIR"
    rm -rf "$BUILD_DIR"
    if [ $? -eq 0 ]; then
        echo "Build directory removed."
    else
        echo "Error removing build directory."
        exit 1
    fi
else
    echo "No build directory found."
fi

# Remove exe directory
if [ -d "$EXE_DIR" ]; then
    echo "Removing executable directory: $EXE_DIR"
    rm -rf "$EXE_DIR"
    if [ $? -eq 0 ]; then
        echo "Executable directory removed."
    else
        echo "Error removing executable directory."
    fi
else
    echo "No executable directory found."
fi

# Remove log file from the root directory
if [ -f "$ACTIVE_CLONE/log.ww4" ]; then
    echo "Removing log file: $ACTIVE_CLONE/log.ww4"
    rm -f "$ACTIVE_CLONE/log.ww4"
    if [ $? -eq 0 ]; then
        echo "Log file removed."
    else
        echo "Error removing log file."
    fi
else
    echo "No log file found."
fi

echo -e "\nClean all complete."
